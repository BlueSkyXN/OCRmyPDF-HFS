# This file is exported to the Space root. BUILD_SOURCE.json is generated by
# export_space_bundle.sh and must declare a full immutable Git commit.
ARG PYTHON_BASE_IMAGE=python:3.11.9-slim-bookworm
FROM ${PYTHON_BASE_IMAGE}

ARG OCRMY_PDF_VERSION=16.0.4
ARG SOURCE_REPOSITORY=https://github.com/BlueSkyXN/OCRmyPDF-HFS.git
ENV PORT=8000 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ghostscript \
        git \
        jbig2enc \
        pngquant \
        qpdf \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
        tesseract-ocr-eng \
        unpaper \
    && rm -rf /var/lib/apt/lists/*

COPY BUILD_SOURCE.json /opt/hfs/BUILD_SOURCE.json
RUN set -eux; \
    source_ref="$(python -c 'import json; print(json.load(open("/opt/hfs/BUILD_SOURCE.json", encoding="utf-8"))["source_ref"])')"; \
    source_repository="$(python -c 'import json; print(json.load(open("/opt/hfs/BUILD_SOURCE.json", encoding="utf-8"))["source_repository"])')"; \
    test "$source_repository" = "$SOURCE_REPOSITORY"; \
    case "$source_ref" in \
        ????????-????-????-????-????????????) exit 1 ;; \
        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; \
        *) echo "BUILD_SOURCE.json must contain a 40-character lowercase commit" >&2; exit 1 ;; \
    esac; \
    git clone --filter=blob:none --no-checkout "$SOURCE_REPOSITORY" /opt/source; \
    if ! git -C /opt/source cat-file -e "${source_ref}^{commit}" 2>/dev/null; then \
        git -C /opt/source fetch --depth=1 origin "$source_ref"; \
    fi; \
    git -C /opt/source checkout --detach "$source_ref"; \
    test "$(git -C /opt/source rev-parse HEAD)" = "$source_ref"; \
    test -f /opt/source/main.py; \
    test -f /opt/source/requirements.txt; \
    pip install --no-cache-dir --requirement /opt/source/requirements.txt \
        "ocrmypdf==${OCRMY_PDF_VERSION}"; \
    install -m 0644 /opt/source/main.py /app/main.py; \
    rm -rf /opt/source

COPY entrypoint.sh /app/entrypoint.sh
RUN install -d -m 1777 /app/temp \
    && chmod 755 /app/entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/app/entrypoint.sh"]
